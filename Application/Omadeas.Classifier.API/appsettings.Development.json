{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=Omadeas_Classifier;Username=postgres;Password=postgres;Include Error Detail=true",
    "Redis": "localhost:6379"
  },

  "Serilog": {
    "MinimumLevel": "Information",
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AuthServiceURL": "https://auth.twincoretech.com",
  "Jwt": {
    "PublicKeyPemPath": "public_key.pem",
    "Issuer": "https://auth.twincoretech.com" // Use the same issuer as your Auth service
  },
  "Caching": {
    "DefaultExpiryHours": 24,
    "Redis": {
      "InstanceName": "Common",
      "AbortOnConnectFail": false,
      "ConnectTimeoutMs": 5000,
      "ResponseTimeoutMs": 5000,
      "DefaultDatabase": 0,
      "UseSsl": false,
      "CheckCertificateRevocation": true
    }
  }
}
