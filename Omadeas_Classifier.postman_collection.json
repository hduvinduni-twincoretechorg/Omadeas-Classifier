          "name": "GET all profiles",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/classifiers/profiles?companyId={{platformTenantId}}&isActive=true",
              "host": ["{{baseUrl}}"],
              "path": ["api", "classifiers", "profiles"],
              "query": [
                { "key": "companyId", "value": "{{platformTenantId}}" },
                { "key": "source", "value": "platform", "disabled": true },
                { "key": "isActive", "value": "true" }
              ]
            }
          }
        },
        {
          "name": "POST create profile",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
